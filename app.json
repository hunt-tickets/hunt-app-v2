{
  "name": "steercode-project",
  "slug": "hunt-tickets",
  "version": "1.0.0",
  "orientation": "portrait",
  "icon": "./assets/images/icon.png",
  "scheme": "myapp",
  "userInterfaceStyle": "automatic",
  "newArchEnabled": true,
  "ios": {
    "supportsTablet": true,
    "infoPlist": {
      "NSFaceIDUsageDescription": "Hunt utiliza Face ID para proteger tu cuenta y permitir acceso rápido y seguro a la aplicación.",
      "UIDesignRequiresCompatibility": true
    },
    "bundleIdentifier": "com.anonymous.steercodeproject"
  },
  "android": {
    "adaptiveIcon": {
      "foregroundImage": "./assets/images/adaptive-icon.png",
      "backgroundColor": "#ffffff"
    },
    "edgeToEdgeEnabled": true,
    "permissions": [
      "android.permission.USE_BIOMETRIC",
      "android.permission.USE_FINGERPRINT",
      "android.permission.USE_BIOMETRIC",
      "android.permission.USE_FINGERPRINT"
    ],
    "package": "com.anonymous.steercodeproject"
  },
  "web": {
    "bundler": "metro",
    "output": "single",
    "favicon": "./assets/images/favicon.png"
  },
  "plugins": [
    "expo-router",
    [
      "expo-splash-screen",
      {
        "image": "./assets/images/splash-icon.png",
        "imageWidth": 200,
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      }
    ],
    "expo-font",
    "expo-web-browser",
    [
      "expo-local-authentication",
      {
        "faceIDPermission": "Allow Hunt to use Face ID."
      }
    ]
  ],
  "experiments": {
    "typedRoutes": true
  },
  "extra": {
    "router": {},
    "eas": {
      "projectId": "227c623e-c646-40c2-a398-6921d0cea7d0"
    }
  },
  "owner": "hunt-tickets",
  "runtimeVersion": "1.0.0",
  "updates": {
    "url": "https://u.expo.dev/227c623e-c646-40c2-a398-6921d0cea7d0"
  }
}
